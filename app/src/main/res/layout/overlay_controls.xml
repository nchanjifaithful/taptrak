<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_overlay"
    android:elevation="8dp"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/overlayDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_dot" />

        <TextView
            android:id="@+id/overlayCounts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/overlay_text"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/overlayDetails"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/overlayStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="3"
            android:maxWidth="240dp"
            android:ellipsize="end"
            android:textColor="@color/overlay_text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/overlayPause"
                style="@style/OverlayButton"
                android:src="@drawable/ic_pause" />

            <ImageButton
                android:id="@+id/overlayRestart"
                style="@style/OverlayButton"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/overlay_restart"
                android:src="@drawable/ic_restart" />

            <ImageButton
                android:id="@+id/overlayStop"
                style="@style/OverlayButton"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/overlay_stop"
                android:src="@drawable/ic_stop" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
